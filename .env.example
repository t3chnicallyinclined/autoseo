# ──────────────────────────────────────────────────
# Pipeline mode
# ──────────────────────────────────────────────────
# seo-only (default): polls Gmail, emails SEO packages
# clipper: extracts short clips from a local video
# both: runs both pipelines
MODE=seo-only

# Clipper output delivery: file (disk), email (Gmail), both
DIGEST_MODE=file

# ──────────────────────────────────────────────────
# Core Google / Gmail settings
# ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ──────────────────────────────────────────────────
# Gmail filtering and behavior (MODE=seo-only)
# ──────────────────────────────────────────────────
GMAIL_QUERY=from:drive-shares-dm-noreply@google.com subject:"Item shared with you" has:drive
GMAIL_MAX_RESULTS=10
# If true, only process video files. If false, also process audio files (mp3/m4a/wav/etc).
REQUIRE_VIDEO=false
POLL_INTERVAL_SECS=60

# ──────────────────────────────────────────────────
# Output email (required for MODE=seo-only or DIGEST_MODE=email)
# ──────────────────────────────────────────────────
RESULT_TO=
RESULT_SUBJECT_PREFIX=[autoseo]

# ──────────────────────────────────────────────────
# Working directories / dedupe / database
# ──────────────────────────────────────────────────
WORK_DIR=./work
DEDUPE_FILE=./work/processed_message_ids.txt
CLIPPER_DB=./work/clipper.db
DUMP_DIR=

# ──────────────────────────────────────────────────
# Media processing
# ──────────────────────────────────────────────────
FFMPEG=ffmpeg
FFPROBE=ffprobe
AUDIO_CHUNK_SECS=900
AUTO_CHUNKING=true
AUTO_CHUNK_TARGET_FACTOR=2
AUTO_CHUNK_TARGET_CHUNKS=400
AUTO_CHUNK_MIN_SECS=10
AUTO_CHUNK_MAX_SECS=1800
STT_CONCURRENCY=500
# Optional: cap STT request rate (per minute). Set slightly below your provider limit (e.g. 2400 for 2500 RPM).
STT_RPM_LIMIT=0

# Bypass Gmail/Drive; process a local video file directly (used with MODE=clipper).
LOCAL_VIDEO_PATH=

# ──────────────────────────────────────────────────
# OpenAI / LLM
# ──────────────────────────────────────────────────
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.2-pro-2025-12-11
OPENAI_STT_MODEL=whisper-1

# ──────────────────────────────────────────────────
# SEO prompts (MODE=seo-only)
# ──────────────────────────────────────────────────
SEO_SYSTEM_PROMPT_PATH=./prompts/seo_system.txt
SEO_USER_PROMPT_PATH=./prompts/seo_user.txt
SEO_VARIANTS=3
SEO_VARIANTS_PROMPT_PATH=./prompts/seo_variants.txt

# ──────────────────────────────────────────────────
# Thumbnails (MODE=seo-only)
# ──────────────────────────────────────────────────
THUMBNAIL_SLOTS=5
THUMBNAIL_WINDOW_SECS=6
THUMBNAIL_COUNT=10
THUMBNAIL_FFMPEG_CONCURRENCY=4
# Max height for scaling; set 0 for native resolution grabs.
THUMBNAIL_MAX_HEIGHT=1080
THUMBNAIL_SYSTEM_PROMPT_PATH=./prompts/thumbnail_system.txt
THUMBNAIL_USER_PROMPT_PATH=./prompts/thumbnail_user.txt

# ──────────────────────────────────────────────────
# Clipper: ranking & rendering (MODE=clipper)
# ──────────────────────────────────────────────────
# Number of top clips to render after ranking.
CLIP_TOP_K=10
# Aspect ratios to render: 9x16 (Shorts/Reels/TikTok), 1x1 (LinkedIn), 16x9 (Bluesky/YouTube landscape).
CLIP_RENDER_FORMATS=9x16,1x1,16x9
CLIP_RANKER_SYSTEM_PROMPT_PATH=./prompts/clips/ranker_system.txt
CLIP_RANKER_USER_PROMPT_PATH=./prompts/clips/ranker_user.txt
# Set true to skip per-clip social copy generation.
CLIP_SOCIAL_COPY_DISABLED=false
CLIP_SOCIAL_SYSTEM_PROMPT_PATH=./prompts/clips/social_system.txt
CLIP_SOCIAL_USER_PROMPT_PATH=./prompts/clips/social_user.txt

# ──────────────────────────────────────────────────
# Embedding & VLM re-ranking (optional, MODE=clipper)
# ──────────────────────────────────────────────────
# Local fastembed ONNX model cache (~90 MB).
EMBED_MODEL_DIR=./work/models/fastembed
# Hugging Face API key for remote embeddings + VLM re-rank.
HF_API_KEY=
HF_ROUTER_URL=https://router.huggingface.co
HF_EMBED_PROVIDER=hf-inference
EMBED_MODEL=BAAI/bge-large-en-v1.5
# Enable VLM re-rank after LLM ranker (requires HF_API_KEY).
VLM_RERANK_ENABLED=false
VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
VLM_RERANK_TOP_K=20
VLM_FRAMES_PER_CLIP=5
VLM_FRAME_MAX_DIM=512
# Weight of VLM score: final = (1 - w) * llm_score + w * vlm_score.
VLM_BLEND_WEIGHT=0.5

# ──────────────────────────────────────────────────
# Platform posting (opt-in, MODE=clipper)
# ──────────────────────────────────────────────────
# Comma-separated platforms to enable: youtube, bluesky (aliases: yt, shorts, bsky).
# Empty = no posting.
POST_ENABLED_PLATFORMS=
# Safety net: set false to actually post. Both POST_ENABLED_PLATFORMS and POST_DRY_RUN=false are required.
POST_DRY_RUN=true

# YouTube Shorts — requires youtube.upload OAuth scope on your refresh token.
YOUTUBE_PRIVACY_STATUS=unlisted
# Category ID: 24=Entertainment, 22=People & Blogs, 23=Comedy, 17=Sports.
YOUTUBE_CATEGORY_ID=24

# Bluesky ATProto — create an app password at https://bsky.app/settings/app-passwords (NOT your login password).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social
BLUESKY_VIDEO_SERVICE_URL=https://video.bsky.app

# ──────────────────────────────────────────────────
# Show configuration
# ──────────────────────────────────────────────────
# Per-show prompt overrides. Layout: {SHOWS_DIR}/{show_slug}/{seo_system,seo_user,...}.txt
SHOWS_DIR=./prompts/shows
