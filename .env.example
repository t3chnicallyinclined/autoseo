# ============================================================
# autoseo — complete environment variable reference
# Copy to .env and fill in required values marked with (required).
# ============================================================

# --- Core Google / Gmail settings ---
GOOGLE_CLIENT_ID=                         # (required for Gmail/Drive modes)
GOOGLE_CLIENT_SECRET=                     # (required for Gmail/Drive modes)
GOOGLE_REFRESH_TOKEN=                     # (required for Gmail/Drive modes)

# --- Gmail filtering and behavior ---
GMAIL_QUERY=from:drive-shares-dm-noreply@google.com subject:"Item shared with you" has:drive
GMAIL_MAX_RESULTS=10
REQUIRE_VIDEO=false
POLL_INTERVAL_SECS=60

# --- Output email ---
RESULT_TO=                                # (required unless --dry-run)
RESULT_SUBJECT_PREFIX=[autoseo]

# --- Working directories / dedupe / storage ---
WORK_DIR=./work
DEDUPE_FILE=./work/processed_message_ids.txt
CLIPPER_DB=./work/clipper.db
DUMP_DIR=

# --- Pipeline mode ---
# "seo-only" (default), "clipper", or "both"
MODE=seo-only

# --- Local video ingest (bypasses Gmail/Drive) ---
LOCAL_VIDEO_PATH=

# --- Digest delivery ---
# "file" (default — writes digest.md), "email" (via Gmail), or "both"
DIGEST_MODE=file

# --- Show-specific prompt overrides ---
SHOWS_DIR=./prompts/shows

# --- Media processing ---
FFMPEG=ffmpeg
FFPROBE=ffprobe
AUDIO_CHUNK_SECS=900
AUTO_CHUNKING=true
AUTO_CHUNK_TARGET_FACTOR=2
AUTO_CHUNK_TARGET_CHUNKS=400
AUTO_CHUNK_MIN_SECS=10
AUTO_CHUNK_MAX_SECS=1800
STT_CONCURRENCY=500
# Optional: cap STT request rate (per minute). Set slightly below your provider limit (e.g. 2400 for 2500 RPM).
STT_RPM_LIMIT=0

# --- Thumbnails ---
THUMBNAIL_SLOTS=5
THUMBNAIL_WINDOW_SECS=6
THUMBNAIL_COUNT=10
THUMBNAIL_FFMPEG_CONCURRENCY=4
THUMBNAIL_MAX_HEIGHT=1080

# --- OpenAI / LLM ---
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=                           # (required unless --dry-run)
OPENAI_CHAT_MODEL=gpt-5.2-pro-2025-12-11
OPENAI_STT_MODEL=whisper-1

# --- Prompt paths (SEO) ---
SEO_SYSTEM_PROMPT_PATH=./prompts/seo_system.txt
SEO_USER_PROMPT_PATH=./prompts/seo_user.txt
SEO_VARIANTS=3
SEO_VARIANTS_PROMPT_PATH=./prompts/seo_variants.txt

# --- Prompt paths (thumbnails) ---
THUMBNAIL_SYSTEM_PROMPT_PATH=./prompts/thumbnail_system.txt
THUMBNAIL_USER_PROMPT_PATH=./prompts/thumbnail_user.txt

# --- Clipper: embedding / fastembed ---
# Cache dir for fastembed ONNX model files (~90MB, auto-downloaded on first run).
EMBED_MODEL_DIR=./work/models/fastembed

# --- Clipper: clip ranking ---
CLIP_RANKER_SYSTEM_PROMPT_PATH=./prompts/clips/ranker_system.txt
CLIP_RANKER_USER_PROMPT_PATH=./prompts/clips/ranker_user.txt
CLIP_TOP_K=10

# --- Clipper: social copy ---
CLIP_SOCIAL_SYSTEM_PROMPT_PATH=./prompts/clips/social_system.txt
CLIP_SOCIAL_USER_PROMPT_PATH=./prompts/clips/social_user.txt
CLIP_SOCIAL_COPY_DISABLED=false

# --- Clipper: render formats ---
# Comma-separated: 9x16, 1x1, 16x9
CLIP_RENDER_FORMATS=9x16,1x1,16x9

# --- Posting ---
# Comma-separated platforms: youtube, bluesky (empty = no posting)
POST_ENABLED_PLATFORMS=
# Safety net — must set to false to enable real posting
POST_DRY_RUN=true

# --- YouTube ---
# Privacy on upload: unlisted, private, or public
YOUTUBE_PRIVACY_STATUS=unlisted
# Category: 22 (People & Blogs), 24 (Entertainment), 23 (Comedy), 17 (Sports)
YOUTUBE_CATEGORY_ID=24

# --- Bluesky ---
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_PDS_URL=https://bsky.social
BLUESKY_VIDEO_SERVICE_URL=https://video.bsky.app

# --- Hugging Face Inference (optional — used for HF-routed embeddings + VLM re-rank) ---
HF_API_KEY=
HF_ROUTER_URL=https://router.huggingface.co
HF_EMBED_PROVIDER=hf-inference
EMBED_MODEL=BAAI/bge-large-en-v1.5

# --- VLM re-rank (requires HF_API_KEY) ---
VLM_RERANK_ENABLED=false
VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
VLM_RERANK_TOP_K=20
VLM_FRAMES_PER_CLIP=5
VLM_FRAME_MAX_DIM=512
VLM_BLEND_WEIGHT=0.5
